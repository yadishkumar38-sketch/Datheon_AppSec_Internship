+/**
+ * HARDENED ENDPOINT: Zero-Trust Authorization & Compound Query Defense
+ * 1. Enforces HTTP-only session cookie authentication (401 Unauthorized if missing/tampered).
+ * 2. Cross-references authenticated session caller against database record owner.
+ * 3. Gracefully rejects unauthorized access (403 Forbidden) without leaking database traces.
+ */
+router.get('/dashboard/:appId', authGuard, (req: AuthenticatedRequest, res: Response) => {
+  const { appId } = req.params;
+  const sessionUser = req.sessionUser!;
+
+  // Step 1: Input syntax validation
+  if (!appId || !/^DT-\d{4}-[A-Za-z0-9]+$/.test(appId)) {
+    res.status(400).json({
+      success: false,
+      error: 'InvalidParameterFormat',
+      message: 'Resource identifier format is invalid. Expected format: DT-YYYY-XXXX.',
+    });
+    return;
+  }
+
+  // Step 2: Verify record existence
+  const resourceExists = queryVulnerableByAppId(appId);
+  if (!resourceExists) {
+    res.status(404).json({
+      success: false,
+      error: 'ResourceNotFound',
+      message: 'The requested dashboard record could not be found.',
+    });
+    return;
+  }
+
+  // Step 3: Compound query - filter by BOTH resource ID AND session owner ID
+  const record = queryHardenedByAppIdAndOwner(appId, sessionUser.userId);
+
+  // Step 4: Defense-in-depth ownership verification
+  if (!record) {
+    console.warn(`[SECURITY AUDIT] BOLA attempt rejected for user: ${sessionUser.userId} on resource: ${appId}`);
+    res.status(403).json({
+      success: false,
+      error: 'ForbiddenAccess',
+      message: 'Access denied: You do not possess authorization to view this resource.',
+      statusCode: 403,
+    });
+    return;
+  }
+
+  // Step 5: Return authorized data
+  res.status(200).json({
+    success: true,
+    data: record,
+    authorizedFor: sessionUser.email,
+  });
+});
 
 export default router;
